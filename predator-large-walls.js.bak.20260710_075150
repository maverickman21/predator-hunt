/**
 * PREDATOR LARGE WALLS SIDECAR v1
 *
 * Polls CoinGlass for current large resting limit orders (passive walls)
 * on ETH and BTC.
 * - Serves live data via HTTP for NinjaTrader indicators
 * - Logs to monthly CSV files (auto-rollover when month changes)
 *
 * Run: pm2 start predator-large-walls.js --name predator-walls
 */

require('dotenv').config();                    // ← Loads .env file
const https = require('https');
const http = require('http');
const fs = require('fs');
const path = require('path');

const COINGLASS_API_KEY = process.env.COINGLASS_API_KEY;
if (!COINGLASS_API_KEY) {
    console.error('[WALLS] ERROR: COINGLASS_API_KEY not found in .env file');
    process.exit(1);
}

const POLL_INTERVAL_MS = 20 * 1000;
const MIN_WALL_USD = 500000;
const BASE_URL = 'https://open-api-v4.coinglass.com';
const SYMBOLS = ['ETHUSDT', 'BTCUSDT'];

let latestData = {
    timestamp: null,
    eth: { sell_walls: [], buy_walls: [] },
    btc: { sell_walls: [], buy_walls: [] }
};

// === Monthly CSV handling ===
function getMonthlyFilename() {
    const d = new Date();
    const ym = d.getUTCFullYear() + '-' + String(d.getUTCMonth() + 1).padStart(2, '0');
    return path.join(__dirname, 'large_walls_v1_' + ym + '.csv');
}

const HEADER = 'qld_time,timestamp,symbol,side,price,size_usd,remaining_usd\n';

function ensureCSV(file) {
    if (!fs.existsSync(file)) {
        fs.writeFileSync(file, HEADER);
    }
}

function qldNow() {
    const d = new Date(Date.now() + 10 * 60 * 60 * 1000);
    const p = n => String(n).padStart(2, '0');
    return d.getUTCFullYear() + '-' + p(d.getUTCMonth() + 1) + '-' + p(d.getUTCDate()) + ' '
         + p(d.getUTCHours()) + ':' + p(d.getUTCMinutes()) + ':' + p(d.getUTCSeconds());
}

function fetchLargeOrders(symbol) {
    return new Promise((resolve, reject) => {
        const url = `${BASE_URL}/api/futures/orderbook/large-limit-order?exchange=Binance&symbol=${symbol}`;
        const options = {
            headers: { 'CG-API-KEY': COINGLASS_API_KEY },
            timeout: 15000
        };

        const req = https.get(url, options, (res) => {
            let body = '';
            res.on('data', chunk => body += chunk);
            res.on('end', () => {
                try {
                    const json = JSON.parse(body);
                    if (json.code === '0' && Array.isArray(json.data)) {
                        resolve(json.data);
                    } else {
                        reject(new Error(json.msg || 'bad response'));
                    }
                } catch (e) {
                    reject(e);
                }
            });
        });

        req.on('timeout', () => { req.destroy(); reject(new Error('timeout')); });
        req.on('error', reject);
    });
}

async function updateWalls() {
    const startedQld = qldNow();

    for (const symbol of SYMBOLS) {
        try {
            const orders = await fetchLargeOrders(symbol);
            const asset = symbol === 'ETHUSDT' ? 'eth' : 'btc';

            const sellWalls = orders
                .filter(o => o.order_side === 1 && parseFloat(o.current_usd_value) >= MIN_WALL_USD)
                .sort((a, b) => parseFloat(b.current_usd_value) - parseFloat(a.current_usd_value));

            const buyWalls = orders
                .filter(o => o.order_side === 2 && parseFloat(o.current_usd_value) >= MIN_WALL_USD)
                .sort((a, b) => parseFloat(b.current_usd_value) - parseFloat(a.current_usd_value));

            latestData[asset] = {
                sell_walls: sellWalls,
                buy_walls: buyWalls
            };

            const csvFile = getMonthlyFilename();
            ensureCSV(csvFile);
            const ts = new Date().toISOString();
            const qld = qldNow();

            sellWalls.forEach(w => {
                fs.appendFileSync(csvFile,
                    `${qld},${ts},${symbol},sell,${w.price},${w.current_usd_value},${w.current_usd_value}\n`);
            });

            buyWalls.forEach(w => {
                fs.appendFileSync(csvFile,
                    `${qld},${ts},${symbol},buy,${w.price},${w.current_usd_value},${w.current_usd_value}\n`);
            });

        } catch (e) {
            console.log(`[WALLS] ${startedQld} FETCH FAILED for ${symbol}: ${e.message}`);
        }
    }

    latestData.timestamp = new Date().toISOString();
    console.log(`[WALLS] ${startedQld} Updated - ETH sell: ${latestData.eth.sell_walls.length}, buy: ${latestData.eth.buy_walls.length}`);
}

function startServer() {
    const server = http.createServer((req, res) => {
        if (req.url === '/api/orderbook/live') {
            res.writeHead(200, { 'Content-Type': 'application/json' });
            res.end(JSON.stringify(latestData));
        } else {
            res.writeHead(404);
            res.end('Not found');
        }
    });

    server.listen(3001, '0.0.0.0', () => {
        console.log('[WALLS] HTTP server listening on port 3001 → /api/orderbook/live');
    });
}

console.log('[WALLS] Predator Large Walls sidecar starting (monthly CSV + .env mode)...');
updateWalls();
setInterval(updateWalls, POLL_INTERVAL_MS);
startServer();
